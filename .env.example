# Copy to .env and fill in, then run:
#
#   node --env-file-if-exists=.env server/server.js
#
# NEVER commit a real .env - it is already covered by .gitignore.
#
# Two kinds of value live here, and the difference matters:
#
#   PUBLIC  - GOOGLE_CLIENT_ID ships to the browser by design. Sign in with
#             Google's credential flow has no code exchange, so there is no
#             client secret at all.
#   SECRET  - FIREWORKS_API_KEY must never reach the browser. It is read only by
#             the server, and the Content-Security-Policy blocks the page from
#             calling the provider directly, so a mistake cannot quietly expose
#             it. Anyone holding it can spend your credits.

# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). This value is public; it ships to the browser.
GOOGLE_CLIENT_ID=your-id.apps.googleusercontent.com

PORT=8000
HOST=0.0.0.0

# Origins allowed to make state-changing requests. Comma separated.
# Must list the exact scheme + host + port the app is served from.
ALLOWED_ORIGINS=http://localhost:8000

# --- Production ---
# Both of these are REQUIRED in production; the server refuses to start without
# them, rather than running with sessions exposed.
# NODE_ENV=production
# SECURE_COOKIES=true
# ALLOWED_ORIGINS=https://your.domain

# --- Storage ---
# Leave all of this unset and the server keeps its progress in a local SQLite
# file, which needs no setup at all.
#
# To use Supabase Postgres instead, run server/schema.sql once in the Supabase
# dashboard (SQL Editor -> New query -> paste -> Run), then set BOTH of these.
# Setting only one is refused at boot rather than silently falling back.
#
#   Project URL   Settings -> Data API -> Project URL. Not secret.
#   Service key   Settings -> API Keys -> service_role. VERY SECRET: it bypasses
#                 row level security. Never use the anon/publishable key here -
#                 schema.sql enables RLS with no policies, so the anon key would
#                 read nothing and every query would look like an empty database.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY= here
# SUPABASE_TIMEOUT_SECONDS=10

# Where the SQLite file lives, when Supabase is not configured.
# Keep it off any path the web server can reach.
# DB_PATH=./server/data/theory101.db

# SESSION_TTL_DAYS=30

# --- The tutor ---
# SECRET. From https://fireworks.ai -> API keys. Without it the tutor simply
# does not appear; everything else in the app works unchanged.
FIREWORKS_API_KEY=fw_your_key_here

# Any OpenAI-compatible endpoint works. Check the model slug in your provider's
# dashboard before running - slugs change more often than you would think.
# ASSISTANT_URL=https://api.fireworks.ai/inference/v1/chat/completions
# ASSISTANT_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct

# Cost controls. The cooldown is enforced by the server, not the browser.
# ASSISTANT_COOLDOWN_SECONDS=10
# ASSISTANT_DAILY_LIMIT=40
# ASSISTANT_TIMEOUT_SECONDS=20
# ASSISTANT_MAX_TOKENS=350

# Canned replies for testing, so no credits are spent: true | leak | slow | fail
# The server REFUSES TO START with this set in production.
# ASSISTANT_FAKE=true
