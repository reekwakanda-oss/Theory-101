# Real user data. The database holds email addresses and session hashes -
# committing it would publish both.
server/data/
*.db
*.db-wal
*.db-shm

# Environment. .env.example is committed; .env never is.
.env
.env.*
!.env.example

node_modules/
npm-debug.log*

.DS_Store
Thumbs.db

# Vendored agent tooling. Reinstalled by `npx impeccable update`, which rewrites
# the whole tree - committing it buries every real change under a 6 MB diff.
# The project config beside it (.claude/settings.json, .codex/hooks.json) stays
# tracked, because a collaborator does need that.
.claude/skills/
.agents/skills/
